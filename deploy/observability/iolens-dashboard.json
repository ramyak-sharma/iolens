{
  "uid": "iolens",
  "title": "iolens",
  "tags": [
    "iolens",
    "storage"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "editable": true,
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "device",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(iolens_request_total_seconds_count, device)",
          "refId": "v"
        },
        "definition": "label_values(iolens_request_total_seconds_count, device)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(iolens_request_total_seconds_count{device=~\"$device\"}, namespace)",
          "refId": "v"
        },
        "definition": "label_values(iolens_request_total_seconds_count{device=~\"$device\"}, namespace)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "pod",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(iolens_request_total_seconds_count{device=~\"$device\",namespace=~\"$namespace\"}, pod)",
          "refId": "v"
        },
        "definition": "label_values(iolens_request_total_seconds_count{device=~\"$device\",namespace=~\"$namespace\"}, pod)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Findings",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "iolens_finding_active == 1",
          "format": "table",
          "instant": true
        }
      ],
      "description": "Active findings. The sentence for each is in the agent log and on /findings; this table shows rule, device, victim and culprit.",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "node": true
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "p99 total latency by pod",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le, pod, device) (rate(iolens_request_total_seconds_bucket{device=~\"$device\",namespace=~\"$namespace\",pod=~\"$pod\"}[1m])))",
          "legendFormat": "{{pod}} {{device}}"
        }
      ],
      "description": "Queue plus device time. Octave buckets, so the value is at most 2x off; the agent's own percentiles (TUI, findings) use the finer buckets.",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Latency heatmap ($device)",
      "type": "heatmap",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (le) (rate(iolens_request_total_seconds_bucket{device=~\"$device\",namespace=~\"$namespace\",pod=~\"$pod\"}[$__rate_interval]))",
          "format": "heatmap",
          "legendFormat": "{{le}}"
        }
      ],
      "description": "Every bucket over time. Shows bimodal tails that a single percentile flattens.",
      "options": {
        "calculate": false,
        "yAxis": {
          "unit": "s"
        },
        "color": {
          "scheme": "Oranges",
          "mode": "scheme"
        },
        "cellGap": 1
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Device time vs total time ($pod)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(iolens_request_device_seconds_bucket{device=~\"$device\",namespace=~\"$namespace\",pod=~\"$pod\"}[1m])))",
          "legendFormat": "device p99"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(iolens_request_total_seconds_bucket{device=~\"$device\",namespace=~\"$namespace\",pod=~\"$pod\"}[1m])))",
          "legendFormat": "total p99"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(iolens_request_device_seconds_sum{device=~\"$device\",namespace=~\"$namespace\",pod=~\"$pod\"}[1m])) / sum(rate(iolens_request_device_seconds_count{device=~\"$device\",namespace=~\"$namespace\",pod=~\"$pod\"}[1m]))",
          "legendFormat": "device mean"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(iolens_request_total_seconds_sum{device=~\"$device\",namespace=~\"$namespace\",pod=~\"$pod\"}[1m])) / sum(rate(iolens_request_total_seconds_count{device=~\"$device\",namespace=~\"$namespace\",pod=~\"$pod\"}[1m]))",
          "legendFormat": "total mean"
        }
      ],
      "description": "Device rising at constant load means the disk got slower. A gap between total and device means requests are queueing.",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Throughput share by pod",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (pod) (rate(iolens_request_bytes_total{device=~\"$device\",namespace=~\"$namespace\",pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "{{pod}}"
        }
      ],
      "description": "Stacked to 100%. A noisy neighbour shows up as one pod taking most of the device.",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 40,
            "stacking": {
              "mode": "percent",
              "group": "A"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Device health",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (device) (iolens_device_iops{device=~\"$device\"})",
          "legendFormat": "{{device}} iops"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "iolens_device_queue_depth{device=~\"$device\"}",
          "legendFormat": "{{device}} queue depth"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "iolens_device_utilization_ratio{device=~\"$device\"} * 100",
          "legendFormat": "{{device}} util %"
        }
      ],
      "description": "%util is the share of time with at least one request in flight. On NVMe and other parallel devices 100% does NOT mean saturated; queue depth is the better signal.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Pressure (PSI)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "iolens_node_io_pressure_ratio",
          "legendFormat": "node {{kind}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (pod, kind) (rate(iolens_cgroup_io_pressure_seconds_total{namespace=~\"$namespace\",pod=~\"$pod\",pod!=\"\"}[1m]))",
          "legendFormat": "{{pod}} {{kind}}"
        }
      ],
      "description": "Share of time tasks were stalled on I/O. Also counts waiting the tracepoints cannot see, like waiting for a free request tag.",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "title": "Agent self metrics",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "iolens_agent_bpf_run_ns_per_event",
          "legendFormat": "{{program}} ns/event"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(iolens_agent_collect_seconds_bucket[5m]))) * 1e9",
          "legendFormat": "collect p99 (ns)"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "iolens_agent_inflight_entries",
          "legendFormat": "in flight entries"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      }
    }
  ]
}
